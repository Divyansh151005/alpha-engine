# Copy to .env and fill in real values: cp .env.example .env

# PostgreSQL (POSTGRES_* names are also accepted and take precedence)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=alpha_engine
DB_USER=alpha_user
DB_PASSWORD=change-me

# Runtime settings (alpha_engine/core/config.py)
EXCHANGE_NAME=binance
DEFAULT_SYMBOL=BTCUSDT
BASE_RISK_PER_TRADE=0.01
TARGET_ANNUAL_VOL=0.2
MAX_DRAWDOWN=0.15

# Logging
LOG_LEVEL=INFO
